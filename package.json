{
  "name": "remotion-reel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts Reel out/reel.mp4",
    "render": "remotion render src/index.ts Reel out/reel.mp4 --props=content.json",
    "cover": "remotion still src/index.ts Cover out/cover.png --props=content.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  },
  "allowScripts": {
    "esbuild@0.18.6": true
  }
}
