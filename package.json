{
  "name": "remotion-reel",
  "version": "1.0.0",
  "private": true,
 "scripts": {
  "generate:audio": "tsx scripts/generate-audio.ts",
  "watch:audio": "tsx scripts/generate-audio.ts --watch",
  "start": "npm run dev",
  "dev": "concurrently -k \"npm run watch:audio\" \"remotion studio src/index.ts\"",
  "build": "npm run generate:audio && remotion render src/index.ts Reel out/reel.mp4",
  "render": "npm run generate:audio && remotion render src/index.ts Reel out/reel.mp4",
  "cover": "npm run generate:audio && remotion still src/index.ts Cover out/cover.png"
},
  "dependencies": {
    "@remotion/cli": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "5.5.4"
  },
  "allowScripts": {
    "esbuild@0.18.6": true
  }
}
